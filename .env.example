# ==================================================
# OpenAlfred Configuration
# Copy this file to .env and fill in your values.
# ==================================================

# ──────────────────────────────────
# LLM / AI Settings
# ──────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key
CEREBRAS_API_KEY=
GOOGLE_API_KEY=
LANGSMITH_API_KEY=your-langsmith-api-key
TAVILY_API_KEY=tvly-your-tavily-api-key

# ──────────────────────────────────
# Model Configuration
# ──────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_MODEL_NAME=gemma4:e2b
CLOUD_CHAT_MODEL=gpt-6-sol
# Dedicated Images API model used by the chat's generate_image tool.
IMAGE_GENERATION_MODEL=gpt-image-2.5-flare
CLOUD_BROWSER_MODEL=gpt-5.4-mini
CEREBRAS_CHAT_MODEL=llama-4-scout
GEMINI_CHAT_MODEL=gemini-3-flash-preview
DEEPSEEK_API_KEY=
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
MIMO_API_KEY=
MIMO_CHAT_MODEL=mimo-v2.6-pro
MIMO_VISION_MODEL=mimo-v2.6-flash
# Independent summary model; does not change the chat or memory extraction model.
MIMO_SUMMARY_MODEL=mimo-v2.6-flash
# Independent title model; a failure is reported, never replaced with another provider.
MIMO_TITLE_MODEL=mimo-v2.6-flash
MEMORY_MODEL_SELECTION=mimo

# 上下文总预算（含系统提示、工具定义、摘要、历史、输出预留与安全余量）。
# cl100k_base 文本估算，不等同于所有模型的精确计费 token；不得超过所选模型上下文窗口。
MAX_CONTEXT_TOKENS=65536
# Full generation cap (reasoning + answer); reserved before every model call.
# This is a ceiling, not a target: short answers do not consume all of it.
CONTEXT_OUTPUT_RESERVE=16384
CONTEXT_SAFETY_MARGIN=2048
# Legacy compatibility only; message count no longer triggers compaction.
MAX_CONTEXT_MESSAGES=20
CONTEXT_SUMMARY_TOKENS=1600
# API generation allowance, separate from the final stored summary length.
# Included in CONTEXT_SUMMARY_INPUT_TOKENS; extra allowance reduces batch size.
CONTEXT_SUMMARY_GENERATION_TOKENS=4096
# Total summary request budget, including previous summary, schema and output reserve.
# Set within the summary model's context window; 32768 avoids tiny serial batches.
CONTEXT_SUMMARY_INPUT_TOKENS=32768
CONTEXT_SUMMARY_MODEL=mimo-summary
# Total deadline for all summary batches in one context preparation, not per batch.
CONTEXT_COMPACTION_TIMEOUT_SECONDS=300
CONTEXT_TOOL_RESULT_TOKENS=1200
# Inline original results up to this size; larger results use stable previews.
CONTEXT_TOOL_INLINE_TOKENS=8192
# Outside the protected recent turns, use referenced previews above this size.
CONTEXT_OLD_TOOL_INLINE_TOKENS=2048
# Complete user-led turns (current turn included); never split a tool call/result group.
# If the protected turns do not fit, report an error instead of silently discarding them.
CONTEXT_KEEP_RECENT_TURNS=2
# Fractions of available INPUT budget; compact once and leave headroom.
CONTEXT_COMPACT_TRIGGER=0.90
CONTEXT_COMPACT_TARGET=0.65
# 每张图片额外预留；超大图片需按实际模型提高，不会为计数下载图片。
CONTEXT_IMAGE_TOKENS=8192

# ──────────────────────────────────
# LiveKit (Voice / SIP)
# ──────────────────────────────────
# LIVEKIT_URL is used by cloud/SIP phone calls.
# LIVEKIT_WS_URL is used by the local wake-word ear service; keep it local
# when your cloud SIP bridge runs on a remote server.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_SIP_TRUNK_ID=ST_Bcj2LDXqL4J7
LIVEKIT_WS_URL=ws://localhost:7880

# ──────────────────────────────────
# TTS (Text-to-Speech)
# ──────────────────────────────────
TTS_URL=http://localhost:7017/v1/audio/speech
TTS_MODEL=tts-1
TTS_VOICE=yingxue
TTS_SAMPLE_RATE=24000
TTS_JITTER_BUFFER_MS=80

# ──────────────────────────────────
# SenseVoice STT (Speech-to-Text)
# ──────────────────────────────────
SENSEVOICE_STT_URL=http://127.0.0.1:8000/extract_text

# ──────────────────────────────────
# Greeting TTS
# ──────────────────────────────────
GREETING_TTS_URL=http://127.0.0.1:10096/tts/stream

# ──────────────────────────────────
# JWT Authentication
# ──────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ──────────────────────────────────
# LangGraph Server
# ──────────────────────────────────
LANGGRAPH_API_URL=http://localhost:2024

# Coding subagent: uses the explicitly selected chat provider, no model fallback.
# Read-only private tools stay bound to the authenticated user. Generated code
# receives selected data snapshots, never credentials or main application APIs.
CODING_CONCURRENCY=2
CODING_MAX_MODEL_CALLS=24
CODING_MAX_REPAIRS=3
# Optional application token estimates: 0 disables the input/cumulative caps.
# Provider context/output limits still apply; calls and deadline remain bounded.
CODING_INPUT_TOKENS=0
CODING_OUTPUT_TOKENS=16000
CODING_TOTAL_TOKENS=0
CODING_TIMEOUT_SECONDS=900
# Optional absolute local checkpoint path; default data/coding-checkpoints.sqlite.
# CODING_CHECKPOINT_PATH=

# ──────────────────────────────────
# Email
# ──────────────────────────────────
EMAIL_ENCRYPTION_KEY=your-fernet-encryption-key

# ──────────────────────────────────
# Context / Memory Management
# ──────────────────────────────────
# Budget settings are defined near the top of this file.
# Legacy SUMMARY_THRESHOLD is no longer used.

# ──────────────────────────────────
# Timezone
# ──────────────────────────────────
# User timezone is reported by the browser and stored per account.
# Do not configure a global TIMEZONE for user schedules.

# ──────────────────────────────────
# Browser Control
# ──────────────────────────────────
CHROME_CDP_URL=http://localhost:9222
# CHROME_USER_DATA_DIR=  (defaults to agent/agent_chrome_profile/)

# ──────────────────────────────────
# Supervisor (Proactive Monitoring)
# ──────────────────────────────────
SUPERVISOR_INTERVAL=600
SUPERVISOR_OCR_WINDOW_MINS=10

# ──────────────────────────────────
# Screenpipe (Eye Tool)
# ──────────────────────────────────
SCREENPIPE_URL=http://localhost:3030
# 可选：管理员预配置本机屏幕归属账号 ID（users.id）。
# 留空时在本机网页的主管设置中绑定当前账号，并通过 Windows 确认框授权。
# 若与已保存的绑定冲突则报错，不会覆盖或回退。
# 新版开关默认关闭，忽略旧的全局 recording_enabled/supervisor_enabled。
SCREEN_MONITOR_USER_ID=
# 可选：覆盖仓库自带的 screenpipe.exe 绝对路径
# SCREENPIPE_EXE=D:/path/to/screenpipe.exe

# ──────────────────────────────────
# Redis (Event Bus)
# ──────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ──────────────────────────────────
# Push Notifications (Bark)
# ──────────────────────────────────

